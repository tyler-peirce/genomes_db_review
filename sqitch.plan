add_core_lookup_indexes 2026-08-04T07:17:59Z Tyler Peirce <tyler.peirce@gmail.com> # Add supporting indexes for core FK and og_id lookup columns (ported from migrations/202607070001_add_core_lookup_indexes.sql).
create_empty_lca_table_copies 2026-08-04T07:19:48Z Tyler Peirce <tyler.peirce@gmail.com> # Create empty structural copies of lca, lca_validation, lca_raw_results, and blast_filtered_lca ahead of re-running the LCA/BLAST pipeline (ported from migrations/202608040001_create_empty_lca_table_copies.sql).
create_v2_schema 2026-08-05T04:10:00Z Tyler Peirce <tyler.peirce@gmail.com> # Create the v2 schema the redesigned lab tables are built in; tables take their final names inside it so cutover is a search_path swap rather than a rename.
create_v2_lab_tables [create_v2_schema] 2026-08-05T04:12:00Z Tyler Peirce <tyler.peirce@gmail.com> # Build the redesigned lab workflow tables in v2, empty: no derived og_id columns, typed dates and measurements, NOT NULL parent FKs with attempt-number uniqueness, a library identity registry replacing sequencing's five polymorphic columns, a shared prep-automation lookup, and the fourteen spreadsheet columns the nightly import has been dropping.
create_v2_browse_views [create_v2_lab_tables] 2026-08-05T04:14:00Z Tyler Peirce <tyler.peirce@gmail.com> # Browse views supplying the ancestor og_id and the derived latest-attempt flag that the v2 tables deliberately do not store.
create_v2_quarantine [create_v2_lab_tables] 2026-08-05T04:40:00Z Tyler Peirce <tyler.peirce@gmail.com> # Single jsonb-backed quarantine table, recording helper, and open-items view, so rows violating the new NOT NULL/FK/type/uniqueness contracts can be fixed at source rather than dropped.
create_v2_summary_view [create_v2_browse_views] 2026-08-05T04:42:00Z Tyler Peirce <tyler.peirce@gmail.com> # Rebuild the workbook's Summary sheet as v2.summary, replacing the nine derived columns removed from v2.sample and adding planned-vs-actual per technology; plus v2.goat_species_v1, the only other view referencing a removed column.
create_v2_lca_tables [create_v2_lab_tables] 2026-08-05T04:44:00Z Tyler Peirce <tyler.peirce@gmail.com> # v2 equivalents of the LCA/mitogenome tables built to the same rules: foreign keys to sample, real primary keys, text throughout, no generated og_num. public.lca_new and siblings untouched.
