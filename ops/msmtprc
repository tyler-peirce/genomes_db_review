# msmtp config for cron mail from this host. Installed to ~tyler/.msmtprc (600).
#
# Target: the Pawsey relay, smtp.pawsey.org.au (mail-server.pawsey.org.au,
# 146.118.78.15). PENDING a Pawsey helpdesk request: as of 2026-11-09 the relay
# is firewalled from this VM, so sends fail with a connect timeout until Pawsey
# opens it. Confirm port, TLS and the From address with Pawsey and adjust below.
#
# Routes that do not work from here (all tried 2026-11-09):
#   - Direct to UWA's MX as genomes-db@nectar-120-134.pawsey.cloud: accepted
#     with 250, then silently dropped. pawsey.cloud publishes "v=spf1 -all"
#     and DMARC p=reject; sp=reject, so no host may send as it or a subdomain.
#   - smtp.office365.com:587 as a UWA mailbox: 535 5.7.3. UWA blocks password
#     SMTP AUTH; only OAuth2 via an Entra app registration would work.
#   - Any From address in uwa.edu.au or pawsey.org.au not sent through that
#     domain's own servers: both publish DMARC p=reject.

defaults
tls            on
tls_starttls   on
tls_trust_file /etc/ssl/certs/ca-certificates.crt
# AppArmor (usr.bin.msmtp) only lets msmtp write logs at ~/.msmtp*.log.
logfile        ~/.msmtp.log

account        pawsey
host           smtp.pawsey.org.au
port           25
auth           off
domain         nectar-120-134.pawsey.cloud
# Must be an address Pawsey's relay is authorised to send for (ask in the ticket).
from           oceanomics-genomes@pawsey.org.au

account default : pawsey
